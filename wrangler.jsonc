{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minthantko-portfolio",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/config.js"]
  }
}
